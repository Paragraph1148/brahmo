# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-jwt-here

# Groq API key (free tier — get one at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Where the Python safety service is listening. Server-side only — the browser
# never talks to it directly, the Next.js /api routes proxy. Start it with:
#   cd backend && uv run uvicorn --factory brahmo.api:create_app
BRAHMO_API_URL=http://127.0.0.1:8000
BRAHMO_API_TIMEOUT_MS=30000
